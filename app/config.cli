# WildFly configuration as code, applied while the image is built
embed-server --std-out=echo --server-config=standalone.xml
/subsystem=logging/logger=lab:add(level=DEBUG)
data-source add --name=LabDS --jndi-name=java:jboss/datasources/LabDS --driver-name=h2 --connection-url="jdbc:h2:mem:lab;DB_CLOSE_DELAY=-1" --user-name=sa --password=sa
stop-embedded-server
